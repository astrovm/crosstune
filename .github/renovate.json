{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:all"
  ],
  "hostRules": [
    {
      "matchHost": "repo.maven.apache.org",
      "concurrentRequestLimit": 1
    },
    {
      "matchHost": "repo1.maven.org",
      "concurrentRequestLimit": 1
    }
  ]
}

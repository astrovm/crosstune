                <data android:host="invidious.nerdvpn.de" />
                <data android:host="invidious.f5.si" />
                <data android:host="invidious.tiekoetter.com" />
                <data android:host="yt.chocolatemoo53.com" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/shorts/" />
                <data android:pathPrefix="/live/" />
                <data android:pathPrefix="/embed/" />
            </intent-filter>
        </activity-alias>


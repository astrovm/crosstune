<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Lets Crosstune find a browser or app for a link other than itself, and see which music
        apps are installed so setup can suggest them.
    -->
    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.apple.android.music" />
        <package android:name="deezer.android.app" />
        <package android:name="com.aspiro.tidal" />
        <package android:name="com.soundcloud.android" />
        <package android:name="com.bandcamp.android" />
        <package android:name="com.amazon.mp3" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Crosstune">

        <meta-data
            android:name="com.astrovm.crosstune.publisher.id"
            android:value="@string/publisher_id" />
        <meta-data
            android:name="com.astrovm.crosstune.publisher.name"
            android:value="@string/publisher_name" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            One alias per source service so each can be turned on or off during setup or in
            Crosstune's settings (see LinkInterception). All start disabled. Third-party apps can't verify these domains, so Android asks the
            user to allow them under "Open by default".
        -->
        <activity-alias
            android:name=".intercept.SPOTIFY"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            tools:ignore="AppLinkWarning">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="open.spotify.com" />
                <data android:pathPattern="/track/.*" />
                <data android:pathPattern="/album/.*" />
                <data android:pathPattern="/artist/.*" />
                <data android:pathPattern="/playlist/.*" />
                <data android:pathPattern="/intl-.*/track/.*" />
                <data android:pathPattern="/intl-.*/album/.*" />
                <data android:pathPattern="/intl-.*/artist/.*" />
                <data android:pathPattern="/intl-.*/playlist/.*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="spotify.link" />
                <data android:host="www.spotify.link" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".intercept.YOUTUBE_MUSIC"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            tools:ignore="AppLinkWarning">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="music.youtube.com" />
                <data android:pathPrefix="/watch" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".intercept.YOUTUBE"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            tools:ignore="AppLinkWarning">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/shorts/" />
                <data android:pathPrefix="/live/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="youtu.be" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".intercept.APPLE_MUSIC"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            tools:ignore="AppLinkWarning">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="music.apple.com" />
                <data android:host="geo.music.apple.com" />
                <data android:pathPattern="/song/.*" />
                <!-- Android's patterns don't backtrack, so a prefix (/us/, /en/, /browse/) needs its own pattern. -->
                <data android:pathPattern="/.*/song/.*" />
                <data android:pathPattern="/album/.*" />
                <data android:pathPattern="/.*/album/.*" />
                <data android:pathPattern="/artist/.*" />
                <data android:pathPattern="/.*/artist/.*" />
                <data android:pathPattern="/playlist/.*" />
                <data android:pathPattern="/.*/playlist/.*" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".intercept.DEEZER"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            tools:ignore="AppLinkWarning">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="deezer.com" />
                <data android:host="www.deezer.com" />
                <data android:pathPattern="/track/.*" />
                <!-- Android's patterns don't backtrack, so a prefix (/us/, /en/, /browse/) needs its own pattern. -->
                <data android:pathPattern="/.*/track/.*" />
                <data android:pathPattern="/album/.*" />
                <data android:pathPattern="/.*/album/.*" />
                <data android:pathPattern="/artist/.*" />
                <data android:pathPattern="/.*/artist/.*" />
                <data android:pathPattern="/playlist/.*" />
                <data android:pathPattern="/.*/playlist/.*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="link.deezer.com" />
                <data android:host="deezer.page.link" />
                <data android:host="dzr.page.link" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".intercept.TIDAL"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            tools:ignore="AppLinkWarning">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="tidal.com" />
                <data android:host="www.tidal.com" />
                <data android:host="listen.tidal.com" />
                <data android:pathPattern="/track/.*" />
                <!-- Android's patterns don't backtrack, so a prefix (/us/, /en/, /browse/) needs its own pattern. -->
                <data android:pathPattern="/.*/track/.*" />
                <data android:pathPattern="/album/.*" />
                <data android:pathPattern="/.*/album/.*" />
                <data android:pathPattern="/artist/.*" />
                <data android:pathPattern="/.*/artist/.*" />
                <data android:pathPattern="/playlist/.*" />
                <data android:pathPattern="/.*/playlist/.*" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".intercept.SOUNDCLOUD"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            tools:ignore="AppLinkWarning">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="soundcloud.com" />
                <data android:host="www.soundcloud.com" />
                <data android:host="m.soundcloud.com" />
                <data android:host="on.soundcloud.com" />
                <data android:pathPattern="/..*" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".intercept.BANDCAMP"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            tools:ignore="AppLinkWarning">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="*.bandcamp.com" />
                <data android:pathPrefix="/track/" />
                <data android:pathPrefix="/album/" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".ClipboardTileService"
            android:exported="true"
            android:icon="@drawable/ic_open_link"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Crosstune">

        <meta-data
            android:name="com.astrovm.crosstune.publisher.id"
            android:value="@string/publisher_id" />
        <meta-data
            android:name="com.astrovm.crosstune.publisher.name"
            android:value="@string/publisher_name" />

        <!--
            singleTop so a link, share or tile tap reaching Crosstune while it's already on screen
            is delivered to onNewIntent instead of just bringing the old screen back.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- "Crosstune" in the menu shown for selected text, e.g. a link in a chat. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            The Quick Settings tile and launcher shortcut read the clipboard through this alias.
            It isn't exported, so other apps can't make Crosstune read the clipboard for them.
        -->
        <activity-alias
            android:name=".PasteFromClipboard"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!--
            One alias per source service so each can be turned on or off during setup or in
            Crosstune's settings (see LinkInterception). All start disabled. Third-party apps can't verify these domains, so Android asks the
            user to allow them under "Open by default". Keep each alias's hosts in sync with LinkInterception.HOSTS.
        -->
        <activity-alias
            android:name=".intercept.SPOTIFY"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            tools:ignore="AppLinkWarning">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="open.spotify.com" />
                <data android:pathPattern="/track/.*" />
                <data android:pathPattern="/album/.*" />
                <data android:pathPattern="/artist/.*" />
                <data android:pathPattern="/playlist/.*" />
                <data android:pathPattern="/intl-.*/track/.*" />
                <data android:pathPattern="/intl-.*/album/.*" />
                <data android:pathPattern="/intl-.*/artist/.*" />
                <data android:pathPattern="/intl-.*/playlist/.*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="spotify.link" />
                <data android:host="www.spotify.link" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".intercept.YOUTUBE_MUSIC"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            tools:ignore="AppLinkWarning">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="music.youtube.com" />
                <data android:pathPrefix="/watch" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".intercept.YOUTUBE"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            tools:ignore="AppLinkWarning">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/shorts/" />
                <data android:pathPrefix="/live/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="youtu.be" />
            </intent-filter>
        </activity-alias>


            android:name=".intercept.AUDIOMACK"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            tools:ignore="AppLinkWarning">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="audiomack.com" />
                <data android:host="www.audiomack.com" />
                <data android:pathPattern="/.*/song/.*" />
                <data android:pathPattern="/.*/album/.*" />
                <data android:pathPattern="/.*/playlist/.*" />
            </intent-filter>
        </activity-alias>

        <!-- Home screen widget: Crosstune in miniature, with Recent and the copied link. -->
        <receiver
            android:name=".CrosstuneWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_crosstune" />
        </receiver>

        <!-- One tap: name the song playing nearby. -->
        <receiver
            android:name=".RecognizeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_recognize_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recognize" />
        </receiver>

        <!-- One tap: name the song playing nearby and show its words. -->
        <receiver
            android:name=".LyricsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_lyrics_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_lyrics" />
        </receiver>

        <service
            android:name=".ClipboardTileService"
            android:exported="true"
            android:icon="@drawable/ic_open_link"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Keeps the words floating over other apps while Crosstune is out of sight. -->
        <service
            android:name=".FloatingLyricsService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the lyrics of the song playing over other apps, in time with it, until the user closes them." />
        </service>

        <!-- Keeps Crosstune from being frozen while the browser signs in with ChatGPT and comes back. -->
        <service
            android:name=".ChatGptSignInService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- Names the song playing nearby and shows its words, from Quick Settings. -->
        <service
            android:name=".LyricsTileService"
            android:exported="true"
            android:icon="@drawable/ic_lyrics"
            android:label="@string/tile_lyrics_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Lets lyrics follow the song a music app plays, once the user allows it; no notification is read. -->
        <service
            android:name=".NowPlayingListener"
            android:exported="true"
            android:label="@string/lyrics_sync_service"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>

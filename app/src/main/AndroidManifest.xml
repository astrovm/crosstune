        <package android:name="com.shazam.android" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <intent>
            <action android:name="com.shazam.android.intent.actions.START_TAGGING" />
        </intent>
        <intent>
            <action android:name="com.google.android.googlequicksearchbox.MUSIC_SEARCH" />
        </intent>
        <!-- Other apps that verify a service's links (LinkInterception.OTHER_LINK_APPS). -->

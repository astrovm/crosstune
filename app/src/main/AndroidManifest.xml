<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only while listening for a song playing nearby, see SongListener. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android's Visualizer needs it to share what the phone plays, which MilkDrop visuals move to. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Lyrics floating over other apps, see-through, kept up by a notification, still listening along. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phones without a microphone can still install Crosstune; they just can't listen. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />


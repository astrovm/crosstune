<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Google Cast, which is Google Play Services: only this flavor has it. See CONTRIBUTING.md, Casting. -->
    <application>
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.astrovm.crosstune.GoogleCastOptions" />
        <meta-data
            android:name="com.google.android.gms.cast.tv.RECEIVER_OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.astrovm.crosstune.GoogleCastReceiverOptions" />

        <!-- A phone casting a song to the TV opens Crosstune there with one of these (Cast Connect). -->
        <activity android:name="com.astrovm.crosstune.MainActivity" tools:node="merge">
            <intent-filter>
                <action android:name="com.google.android.gms.cast.tv.action.LAUNCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.cast.tv.action.LOAD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>

# Git in the image, so whisper.cpp can read its commit on every machine.
# A host Git is a macOS program on a Mac. On Linux it runs here only while the host libc matches this image.
# ffmpeg too: the screenshot tests (scripts/shots/shots.py --box) read the visuals and write the clips with it.
FROM docker.io/library/eclipse-temurin:25-jdk
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# What the widths are measured in: Chromium, with Noto standing where J-Total's page asks for MS Gothic
# and Hiragino Kaku Gothic. This is the machine that shows the same widths Issue #775 measured.
# The pages name no language, so a reader's browser in Japanese draws `monospace` in its Japanese
# fixed-width font: MS Gothic on Windows. Noto Sans Mono CJK JP stands in for it too. Without that
# alias fontconfig falls to WenQuanYi Zen Hei, which draws kana at 2.05 columns, not 2 (Issue #830).
# The image by digest and each font package by version, so a rebuild measures the same fonts.
FROM mcr.microsoft.com/playwright/python:v1.64.1-noble@sha256:330d401ae23c905896a0c26c66c36fc971b621519e7b11b435a8328d7bf6e031
RUN pip install --no-cache-dir playwright==1.64.1
RUN apt-get update && apt-get install -y --no-install-recommends fonts-noto-cjk=1:20230817+repack1-3 fonts-noto-core=20201225-2 fonts-noto-mono=20201225-2 fonts-dejavu-core=2.37-8 fonts-dejavu-mono=2.37-8 && rm -rf /var/lib/apt/lists/*
RUN printf '<?xml version="1.0"?><!DOCTYPE fontconfig SYSTEM "fonts.dtd"><fontconfig>\n<alias binding="same"><family>MS Gothic</family><prefer><family>Noto Sans Mono CJK JP</family></prefer></alias>\n<alias binding="same"><family>Hiragino Kaku Gothic</family><prefer><family>Noto Sans Mono CJK JP</family></prefer></alias>\n<alias binding="same"><family>sans-serif</family><prefer><family>Noto Sans</family></prefer></alias>\n<alias binding="same"><family>monospace</family><prefer><family>Noto Sans Mono CJK JP</family></prefer></alias>\n</fontconfig>\n' > /etc/fonts/local.conf && fc-cache -f

package com.astrovm.crosstune

import java.io.File
import java.nio.charset.Charset
import org.json.JSONArray
import org.json.JSONObject
import org.junit.Test
import org.junit.runner.RunWith
import org.robolectric.RobolectricTestRunner

// Not part of the app's tests: compare_sheets.py copies this into the test folder for one run and takes it out again.
// It runs ChordSheets.fromJTotal as ChordFinder does, on every crawled page.
@RunWith(RobolectricTestRunner::class)
class CrawlDumpTest {
    @Test
    fun dump() {
        val dir = File("build/crawl")
        val tag = File(dir, "tag.txt").readText().trim()
        val region = Regex("""<!--HPSTART-->(.*?)<!--HPEND-->""", RegexOption.DOT_MATCHES_ALL)
        val out = File(dir, "app-$tag.jsonl").bufferedWriter()
        val items = JSONArray(File(dir, "urls.json").readText())
        for (i in 0 until items.length()) {
            val item = items.getJSONObject(i)
            val page = String(File(dir, "sheets/" + item.getString("file")).readBytes(), Charset.forName("windows-31j"))
            val sheet = region.find(page)?.groupValues?.get(1) ?: continue
            val mono = ChordSheets.jTotalMonospace(page)
            val lines = ChordSheets.fromJTotal(ChordFinder.unescape(sheet), mono)
            val arr = JSONArray()
            lines.forEach { line ->
                val chords = JSONArray()
                line.chords.forEach { chords.put(JSONArray().put(it.at).put(it.name)) }
                arr.put(JSONObject().put("text", line.text).put("chords", chords))
            }
            out.write(JSONObject().put("url", item.getString("url")).put("mono", mono).put("lines", arr).toString())
            out.newLine()
        }
        out.close()
    }
}

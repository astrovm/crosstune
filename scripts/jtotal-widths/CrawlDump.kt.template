package com.astrovm.crosstune

import java.io.File
import java.nio.charset.Charset
import org.junit.Test

// Not part of the app's tests: compare_sheets.py copies this into the test folder for one run and takes it out again.
// It runs ChordSheets.fromJTotal as ChordFinder does, on every crawled page. It is a plain JUnit test, with no
// Android classes, so it runs where Robolectric's native runtime does not, as in the Gradle box on an arm64 Mac.
class CrawlDumpTest {
    @Test
    fun dump() {
        val dir = File("build/crawl")
        val tag = File(dir, "tag.txt").readText().trim()
        val region = Regex("""<!--HPSTART-->(.*?)<!--HPEND-->""", RegexOption.DOT_MATCHES_ALL)
        val out = File(dir, "app-$tag.jsonl").bufferedWriter()
        // compare_sheets.py writes one sheet a line: its file, a tab, its address.
        File(dir, "urls.tsv").readLines().filter { it.isNotBlank() }.forEach { row ->
            val (file, url) = row.split('\t', limit = 2)
            val page = String(File(dir, "sheets/$file").readBytes(), Charset.forName("windows-31j"))
            val sheet = region.find(page)?.groupValues?.get(1) ?: return@forEach
            val mono = ChordSheets.jTotalMonospace(page)
            val lines = ChordSheets.fromJTotal(ChordFinder.unescape(sheet), mono)
            val written = lines.joinToString(",", "[", "]") { line ->
                val chords = line.chords.joinToString(",", "[", "]") { "[${it.at},${json(it.name)}]" }
                """{"text":${json(line.text)},"chords":$chords}"""
            }
            out.write("""{"url":${json(url)}""" + ""","mono":$mono""" + ""","lines":$written}""")
            out.newLine()
        }
        out.close()
    }

    private fun json(text: String): String = buildString {
        append('"')
        text.forEach { char ->
            when {
                char == '"' || char == '\\' -> append('\\').append(char)
                char < ' ' -> append("\\u%04x".format(char.code))
                else -> append(char)
            }
        }
        append('"')
    }
}
